# Internal CA cert + key, kept in Key Vault as two PEM secrets and synced into cert-manager's namespace.
# Upload once (someone with Key Vault Secrets Officer):
#   az keyvault secret set --vault-name <kv> -n cuberai-internal-ca-crt -f ca.crt
#   az keyvault secret set --vault-name <kv> -n cuberai-internal-ca-key -f ca.key
# Use an intermediate CA signed by your corporate root, not the root itself.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cuberai-internal-ca
  namespace: cert-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: azure-key-vault
  target:
    name: cuberai-internal-ca
    creationPolicy: Owner
    template:
      type: kubernetes.io/tls
      data:
        tls.crt: "{{ .crt }}"
        tls.key: "{{ .key }}"
  data:
    - secretKey: crt
      remoteRef:
        key: cuberai-internal-ca-crt
    - secretKey: key
      remoteRef:
        key: cuberai-internal-ca-key

# Signs certificates with the internal CA. ClusterIssuer secrets are read from cert-manager's namespace.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: cuberai-internal-ca
spec:
  ca:
    secretName: cuberai-internal-ca
